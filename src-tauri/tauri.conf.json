{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blazon",
  "version": "0.1.0",
  "identifier": "app.blazon.browser",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "shortDescription": "Blazon - navegador leve com Spaces e bras\u00f5es",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "resources": {
      "adblock/": "adblock/"
    }
  }
}
